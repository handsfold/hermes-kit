--- /dev/null
+++ b/tests/gateway/test_telegram_effort.py
@@ -0,0 +1,47 @@
+"""Every effort offered by Telegram must reach the Codex transport intact."""
+
+import pytest
+
+import gateway.run as gateway_run
+from agent.transports.codex import ResponsesApiTransport
+from plugins.platforms.telegram.telegram_effort import EFFORTS, clavier_effort
+from tests.gateway.test_reasoning_command import _make_event, _make_runner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("effort", [value for _, value in EFFORTS])
+@pytest.mark.parametrize("global_scope", [False, True])
+async def test_menu_effort_survives_command_resolution_and_transport(
+    tmp_path, monkeypatch, effort, global_scope,
+):
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    (tmp_path / "config.yaml").write_text("agent:\n  reasoning_effort: high\n")
+    runner = _make_runner()
+    event = _make_event(f"/reasoning {effort}" + (" --global" if global_scope else ""))
+    result = await runner._handle_reasoning_command(event)
+    assert "✓" in result
+    if global_scope:
+        runner = _make_runner()  # Reload the saved default as after a restart.
+    config = runner._resolve_session_reasoning_config(source=event.source)
+    kwargs = ResponsesApiTransport().build_kwargs(
+        model="gpt-6-astra",
+        instructions="Test only.",
+        messages=[{"role": "user", "content": "Hello"}],
+        tools=[],
+        reasoning_config=config,
+        is_codex_backend=True,
+    )
+    assert kwargs["reasoning"]["effort"] == effort
+    assert not {"temperature", "top_p", "top_logprobs"}.intersection(kwargs)
+
+
+@pytest.mark.parametrize("prefix,global_prefix", [("me", "meg"), ("menu:e", "menu:eg")])
+def test_effort_buttons_keep_callback_indices_and_selected_state(prefix, global_prefix):
+    for selected, (_, effort) in enumerate(EFFORTS):
+        rows = clavier_effort(
+            effort, prefixe=prefix, prefixe_global=global_prefix, retour=False,
+        ).inline_keyboard
+        for index, row in enumerate(rows):
+            assert row[0].callback_data == f"{prefix}:{index}"
+            assert row[1].callback_data == f"{global_prefix}:{index}"
+            assert row[0].text.startswith("✓") == (index == selected)
