new file mode 100644
index 0000000000..f5439b34f1
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_effort.py
@@ -0,0 +1,44 @@
+"""Clavier d'effort de raisonnement, propose apres le choix d'un modele.
+
+Un tap sur un niveau = `/reasoning <niveau>` (colonne gauche, ce topic) ou
+`/reasoning <niveau> --global` (colonne droite, defaut partout). Les callback_data
+sont `<prefixe>:<i>` et `<prefixe_global>:<i>`, i indexant EFFORTS : garder les
+indices pour les boutons deja envoyes sur Telegram.
+"""
+from __future__ import annotations
+
+from typing import List, Tuple
+
+from telegram import InlineKeyboardButton, InlineKeyboardMarkup
+
+# Astra accepte ces cinq niveaux via Codex. ultra appartient au client Codex et
+# n'est pas accepte par l'API (2026-09-13).
+EFFORTS: List[Tuple[str, str]] = [
+    ("Leger · low", "low"),
+    ("Equilibre · medium", "medium"),
+    ("Pousse · high", "high"),
+    ("Tres pousse · xhigh", "xhigh"),
+    ("Maximum · max (Astra)", "max"),
+]
+
+
+def clavier_effort(
+    courant: str | None = None,
+    prefixe: str = "me",
+    prefixe_global: str = "meg",
+    retour: bool = False,
+) -> InlineKeyboardMarkup:
+    # Deux colonnes : a gauche pour la session, a droite pour figer le defaut
+    # global, sans rien taper. Le niveau courant est coche, comme le fournisseur
+    # courant dans /model.
+    rows = []
+    for i, (label, niveau) in enumerate(EFFORTS):
+        if courant and niveau == courant:
+            label = f"✓ {label}"
+        rows.append([
+            InlineKeyboardButton(label, callback_data=f"{prefixe}:{i}"),
+            InlineKeyboardButton("epingler", callback_data=f"{prefixe_global}:{i}"),
+        ])
+    if retour:
+        rows.append([InlineKeyboardButton("< Retour", callback_data="menu:root")])
+    return InlineKeyboardMarkup(rows)
diff --git a/tests/gateway/test_telegram_effort.py b/tests/gateway/test_telegram_effort.py
