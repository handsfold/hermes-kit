+    async def _menu_apply_command(self, query, command_text: str) -> None:
+        """Applique une commande (/model, /reasoning) choisie par bouton.
+
+        Fabrique un event COMMAND via le pipeline normal, re-attribue a
+        l'utilisateur qui a touche le bouton (le message porte le bot comme
+        auteur), puis reutilise handle_message : meme chemin que la commande
+        tapee a la main.
+        """
+        msg = getattr(query, "message", None)
+        if msg is None:
+            await query.answer(text="Contexte indisponible."); return
+        try:
+            event = self._build_message_event(msg, MessageType.COMMAND)
+        except Exception as e:  # noqa: BLE001
+            logger.warning("[%s] menu apply build failed: %s", self.name, e)
+            await query.answer(text="Erreur."); return
