+_VOICE_MODE_FILENAME = "gateway_voice_mode.json"
+_VOICE_MODES = {"off", "voice_only", "all"}
+
+
+def _voice_mode_for(platform_name: str, chat_id: str) -> str:
+    """Persisted voice mode for a chat, as written by the gateway's ``/voice`` command.
+
+    The scheduler may run out-of-process, so ``gateway_voice_mode.json`` is re-read on every
+    delivery rather than cached. Keys are ``<platform>:<chat_id>``, or ``<profile>:<platform>:
+    <chat_id>`` under multiplexing (see ``GatewayVoiceMixin._voice_key``).
+    """
+    try:
+        raw = (_sched._get_hermes_home() / _VOICE_MODE_FILENAME).read_text(encoding="utf-8")
+        data = json.loads(raw)
+    except (FileNotFoundError, json.JSONDecodeError, OSError, ValueError):
+        return "off"
+    if not isinstance(data, dict):
+        return "off"
+    suffix = f"{str(platform_name).lower()}:{chat_id}"
+    mode = data.get(suffix)
+    if mode is None:  # multiplexed key carries a profile prefix
+        mode = next((v for k, v in data.items() if str(k).endswith(f":{suffix}")), None)
+    return mode if mode in _VOICE_MODES else "off"
+
+
+def _voice_chunks_for_target(platform_name: str, chat_id: str, text: str, job: dict) -> list:
+    """Render *text* to voice files when the target chat has voice mode "all".
+
+    Cron output is delivered outside the normal message pipeline, so without this the user got
+    text only for scheduled jobs even with voice mode on. Returns a (possibly empty) list of
+    audio paths the caller must clean up.
+    """
+    if not text or _voice_mode_for(platform_name, chat_id) != "all":
+        return []
+    try:
+        from gateway.voice_delivery import synthesize_voice_chunks
+        return synthesize_voice_chunks(text, platform=platform_name, prefix="cron_voice")
+    except Exception as e:
+        logger.warning("Job '%s': cron voice synthesis failed: %s", job.get("id", "?"), e)
+        return []
+
