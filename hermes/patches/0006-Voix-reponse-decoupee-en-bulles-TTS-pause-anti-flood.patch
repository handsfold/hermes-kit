index 0000000000..a4ac610107
--- /dev/null
+++ b/gateway/voice_delivery.py
@@ -0,0 +1,225 @@
+"""Shared helpers to turn a long text reply into one or more TTS voice files.
+
+Two problems this module solves:
+
+1. ``text_to_speech_tool`` truncates anything above the provider's
+   ``max_text_length`` (edge-tts: 5000 chars).  A long agent reply therefore
+   produced a single audio covering only its first part.  ``split_text_for_tts``
+   cuts the text on paragraph / sentence boundaries so every part is spoken.
+
+2. Cron job deliveries never went through the gateway's voice path at all.
+   ``synthesize_voice_chunks`` is provider- and platform-agnostic so both the
+   live reply path (``gateway/run.py``) and the cron delivery path
+   (``cron/scheduler.py``) can use it.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+import tempfile
+import uuid as _uuid
+from typing import List, Optional
+
+logger = logging.getLogger(__name__)
+
+# Hard ceiling on how many voice messages a single reply may produce, so a
+# runaway 100k-char answer can't flood the chat with 30 audio bubbles.
+MAX_VOICE_CHUNKS = 12
+
+# Safety margin under the provider cap: markdown stripping can slightly grow
+# the text (e.g. link expansion), and providers count characters differently.
+_CHUNK_SAFETY_RATIO = 0.95
+
+_SENTENCE_SPLIT_RE = re.compile(r"(?<=[.!?…:;])\s+")
+
+
+def resolve_tts_chunk_size(default: int = 4000) -> int:
+    """Return the safe per-request character budget for the active TTS provider."""
+    try:
+        from tools.tts_tool import (
+            _get_provider,
+            _load_tts_config,
+            _resolve_max_text_length,
+        )
+
+        tts_config = _load_tts_config()
+        provider = _get_provider(tts_config)
+        max_len = int(_resolve_max_text_length(provider, tts_config))
+    except Exception as exc:  # pragma: no cover - defensive
+        logger.debug("Could not resolve TTS max length (%s), using %d", exc, default)
+        return default
+    if max_len <= 0:
+        return default
+    return max(500, int(max_len * _CHUNK_SAFETY_RATIO))
+
+
+def _hard_split(text: str, max_len: int) -> List[str]:
+    """Last-resort splitter for a single run of text with no usable boundary."""
+    out: List[str] = []
+    remaining = text
+    while len(remaining) > max_len:
+        window = remaining[:max_len]
+        cut = window.rfind(" ")
+        if cut < max_len // 2:
+            cut = max_len
+        out.append(remaining[:cut].strip())
+        remaining = remaining[cut:].lstrip()
+    if remaining.strip():
+        out.append(remaining.strip())
+    return out
+
+
+def split_text_for_tts(text: str, max_len: int) -> List[str]:
+    """Split *text* into speakable chunks of at most *max_len* characters.
+
+    Boundaries are preferred in this order: blank line, sentence end, word.
+    Returns ``[]`` for empty input.
+    """
+    text = (text or "").strip()
+    if not text:
+        return []
+    if len(text) <= max_len:
+        return [text]
+
+    # Break into the smallest units we are willing to keep whole.
+    units: List[str] = []
+    for para in re.split(r"\n\s*\n", text):
+        para = para.strip()
+        if not para:
+            continue
+        if len(para) <= max_len:
+            units.append(para)
+            continue
+        for sentence in _SENTENCE_SPLIT_RE.split(para):
+            sentence = sentence.strip()
+            if not sentence:
+                continue
+            if len(sentence) <= max_len:
+                units.append(sentence)
+            else:
+                units.extend(_hard_split(sentence, max_len))
+
+    # Greedily repack units into chunks.
+    chunks: List[str] = []
+    current = ""
+    for unit in units:
+        candidate = f"{current}\n\n{unit}" if current else unit
+        if len(candidate) <= max_len:
+            current = candidate
+        else:
+            if current:
+                chunks.append(current)
+            current = unit
+    if current:
+        chunks.append(current)
+    return chunks
+
+
+def synthesize_voice_chunks(
+    text: str,
+    platform: Optional[str] = None,
+    max_chunks: int = MAX_VOICE_CHUNKS,
+    prefix: str = "tts_reply",
+) -> List[str]:
+    """Render *text* to a list of audio file paths (one per chunk).
+
+    *platform* (e.g. ``"telegram"``) is published as the session platform for
+    the duration of the call so ``text_to_speech_tool`` picks the right
+    container format (Opus for Telegram voice bubbles).
+
+    Never raises: on failure it returns whatever chunks were produced so far.
+    The caller owns the returned files and must unlink them.
+    """
+    import json
+
+    from tools.tts_text_normalize import _strip_markdown_for_tts
+    from tools.tts_tool import text_to_speech_tool
+
+    tts_text = _strip_markdown_for_tts(text or "")
+    if not tts_text or not tts_text.strip():
+        return []
+
+    chunk_size = resolve_tts_chunk_size()
+    chunks = split_text_for_tts(tts_text, chunk_size)
+    if not chunks:
+        return []
+
+    if len(chunks) > max_chunks:
+        logger.warning(
+            "TTS reply needs %d chunks, capping at %d (%d chars dropped)",
+            len(chunks), max_chunks,
+            sum(len(c) for c in chunks[max_chunks:]),
+        )
+        chunks = chunks[:max_chunks]
+
+    token = None
+    if platform:
+        try:
+            from gateway.session_context import _SESSION_PLATFORM
+
+            token = _SESSION_PLATFORM.set(str(platform).lower())
+        except Exception:  # pragma: no cover - defensive
+            token = None
+
+    out_dir = os.path.join(tempfile.gettempdir(), "hermes_voice")
+    os.makedirs(out_dir, exist_ok=True)
+    paths: List[str] = []
+    try:
+        for index, chunk in enumerate(chunks, start=1):
+            # .mp3 extension so edge-tts' conversion to opus works correctly;
+            # the tool returns the real path, which may end in .ogg.
+            request_path = os.path.join(
+                out_dir, f"{prefix}_{_uuid.uuid4().hex[:12]}_{index}.mp3"
+            )
+            # edge-tts occasionally times out on a healthy request; one retry
+            # keeps a transient hiccup from silently dropping a whole chunk
+            # (and every chunk after it).
+            actual = None
+            for attempt in (1, 2):
+                try:
+                    result = json.loads(
+                        text_to_speech_tool(text=chunk, output_path=request_path)
+                    )
+                except Exception as exc:
+                    logger.warning(
+                        "TTS chunk %d/%d attempt %d failed: %s",
+                        index, len(chunks), attempt, exc,
+                    )
+                    continue
+                candidate = result.get("file_path", request_path)
+                if result.get("success") and os.path.isfile(candidate):
+                    actual = candidate
+                    break
+                logger.warning(
+                    "TTS chunk %d/%d attempt %d failed: %s",
+                    index, len(chunks), attempt, result.get("error"),
+                )
+            if actual is None:
+                logger.warning(
+                    "TTS chunk %d/%d gave up after 2 attempts", index, len(chunks)
+                )
+                break
+            paths.append(actual)
+    finally:
+        if token is not None:
+            try:
+                from gateway.session_context import _SESSION_PLATFORM
+
+                _SESSION_PLATFORM.reset(token)
+            except Exception:  # pragma: no cover - defensive
+                pass
+
+    return paths
+
+
+def cleanup_voice_chunks(paths) -> None:
+    """Best-effort deletion of generated audio files."""
+    for path in set(paths or ()):
+        if not path:
+            continue
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
