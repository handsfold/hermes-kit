diff --git a/gateway/bus.py b/gateway/bus.py
new file mode 100644
index 0000000000..5e6ed59572
--- /dev/null
+++ b/gateway/bus.py
@@ -0,0 +1,224 @@
+"""Bus inter-topics : reveiller la session d'un topic, pas seulement lui ecrire.
+
+`send_message` posait un message dans un topic et le miroitait en role
+`assistant`. L'agent d'en face ne se reveillait jamais : Telegram ne renvoie
+pas au bot ses propres messages, et le miroir se relisait comme sa propre
+parole passee, pas comme une demande.
+
+Ce module ferme la boucle. Il injecte un `MessageEvent(internal=True)` dans
+l'adaptateur de la plateforme cible, exactement comme le fait deja
+`_inject_watch_notification` pour les notifications de processus. Le gateway
+recalcule la session_key du topic, lance un vrai tour d'agent, et la reponse
+repart toute seule dans le bon sujet via `event.source`.
+
+Deux gardes, sans lesquelles le bus est une arme :
+
+- profondeur : un topic reveille peut a son tour en reveiller un autre, mais
+  pas indefiniment. Au-dela de PROFONDEUR_MAX, le reveil est refuse et
+  l'appelant recoit la raison.
+- auto-reveil : un topic ne peut pas se reveiller lui-meme, sinon un seul
+  appel suffit a boucler a l'infini.
+"""
+
+import asyncio
+import contextvars
+import logging
+import time
+from typing import Optional
+
+logger = logging.getLogger(__name__)
+
+PROFONDEUR_MAX = 2
+# Deux reveils du meme topic a moins de ce delai sont presque toujours un
+# emballement, pas une intention. Le second est refuse.
+COOLDOWN_S = 3.0
+# Plafond global, dernier rempart. La profondeur voyage par contextvar, et un
+# outil execute dans un thread d'executeur ne la voit pas toujours : sans ce
+# plafond, une chaine A -> B -> C -> A pourrait tourner sans fin.
+FENETRE_S = 60.0
+REVEILS_MAX_PAR_FENETRE = 8
+
+_PROFONDEUR: contextvars.ContextVar = contextvars.ContextVar("hermes_bus_profondeur", default=0)
+
+_gateway = None
+_derniers: dict = {}
+_horodatages: list = []
+
+PREAMBULE = (
+    "[Message relaye par le QG, pas ecrit par USER. Reponds ici normalement : "
+    "ta reponse arrive dans ton topic et le QG la verra.]"
+)
+
+
+def register_gateway(gw) -> None:
+    """Appele une fois au demarrage du gateway. Sans ca, le bus est inerte."""
+    global _gateway
+    _gateway = gw
+
+
+def gateway_disponible() -> bool:
+    return _gateway is not None
+
+
+def profondeur_courante() -> int:
+    try:
+        return int(_PROFONDEUR.get() or 0)
+    except Exception:
+        return 0
+
+
+def _cle_cible(platform_name: str, chat_id: str, thread_id) -> str:
+    return f"{platform_name}:{chat_id}:{thread_id or ''}"
+
+
+def _source_existante(platform_name: str, chat_id: str, thread_id):
+    """Reprend la SessionSource deja enregistree pour ce topic.
+
+    C'est la voie fidele : elle porte le vrai chat_type, le user_id et le nom
+    du salon. Reconstruire a la main devine, et une mauvaise devinette de
+    chat_type produit une autre session_key, donc un autre topic.
+    """
+    store = getattr(_gateway, "session_store", None)
+    if store is None:
+        return None
+    try:
+        entrees = store.list_sessions()
+    except Exception:
+        return None
+    voulu = str(thread_id) if thread_id else None
+    for entree in entrees:
+        origine = getattr(entree, "origin", None)
+        if origine is None:
+            continue
+        plate = getattr(origine, "platform", None)
+        plate = getattr(plate, "value", plate)
+        if str(plate).lower() != platform_name:
+            continue
+        if str(getattr(origine, "chat_id", "")) != str(chat_id):
+            continue
+        vu = getattr(origine, "thread_id", None)
+        vu = str(vu) if vu else None
+        if vu != voulu:
+            continue
+        return origine
+    return None
+
+
+def _source_construite(platform_name: str, chat_id: str, thread_id):
+    """Repli quand le topic n'a aucune session enregistree."""
+    if _gateway is None:
+        return None
+    try:
+        return _gateway._build_process_event_source({
+            "platform": platform_name,
+            "chat_id": str(chat_id),
+            # Un chat_id negatif est un groupe cote Telegram. Un topic sans
+            # groupe n'existe pas, d'ou le repli sur "group" des qu'un
+            # thread_id est present.
+            "chat_type": "group" if (str(chat_id).startswith("-") or thread_id) else "dm",
+            "thread_id": str(thread_id) if thread_id else None,
+        })
+    except Exception as exc:
+        logger.warning("bus: source construite impossible: %s", exc)
+        return None
+
+
+def _adaptateur(platform_name: str):
+    adapters = getattr(_gateway, "adapters", None) or {}
+    for cle, adapter in adapters.items():
+        valeur = getattr(cle, "value", cle)
+        if str(valeur).lower() == platform_name:
+            return adapter
+    return None
+
+
+def reveiller(platform_name: str, chat_id: str, thread_id, texte: str) -> dict:
+    """Injecte `texte` en role user dans la session du topic et lance un tour.
+
+    Retourne un dict {"reveille": bool, ...}. N'emet jamais d'exception :
+    l'envoi du message a deja reussi quand on arrive ici, et un echec de
+    reveil ne doit pas transformer un envoi reussi en erreur.
+    """
+    platform_name = (platform_name or "").strip().lower()
+    if _gateway is None:
+        return {"reveille": False, "raison": "gateway indisponible dans ce processus"}
+
+    profondeur = profondeur_courante()
+    if profondeur >= PROFONDEUR_MAX:
+        return {
+            "reveille": False,
+            "raison": f"profondeur maximale atteinte ({PROFONDEUR_MAX}) : chaine de reveils coupee",
+        }
+
+    adapter = _adaptateur(platform_name)
+    if adapter is None:
+        return {"reveille": False, "raison": f"aucun adaptateur actif pour {platform_name}"}
+
+    source = _source_existante(platform_name, chat_id, thread_id) or _source_construite(
+        platform_name, chat_id, thread_id
+    )
+    if source is None:
+        return {"reveille": False, "raison": "impossible de resoudre la session du topic"}
+
+    # Auto-reveil : la session cible est celle qui parle.
+    try:
+        from gateway.session_context import get_session_env
+        from gateway.session import build_session_key
+
+        cle_cible_session = build_session_key(source)
+        cle_courante = get_session_env("HERMES_SESSION_KEY", "")
+        if cle_courante and cle_courante == cle_cible_session:
+            return {"reveille": False, "raison": "auto-reveil refuse : c'est ce topic qui parle"}
+    except Exception:
+        cle_cible_session = None
+
+    cle = _cle_cible(platform_name, chat_id, thread_id)
+    maintenant = time.time()
+
+    global _horodatages
+    _horodatages = [t for t in _horodatages if maintenant - t < FENETRE_S]
+    if len(_horodatages) >= REVEILS_MAX_PAR_FENETRE:
+        return {
+            "reveille": False,
+            "raison": (
+                f"plafond global atteint ({REVEILS_MAX_PAR_FENETRE} reveils / {FENETRE_S:g}s) : "
+                "emballement suppose, chaine coupee"
+            ),
+        }
+
+    dernier = _derniers.get(cle, 0.0)
+    if maintenant - dernier < COOLDOWN_S:
+        return {"reveille": False, "raison": f"reveil ignore : ce topic vient d'etre reveille (<{COOLDOWN_S:g}s)"}
+    _derniers[cle] = maintenant
+    _horodatages.append(maintenant)
+
+    try:
+        from gateway.platforms.base import MessageEvent, MessageType
+
+        evenement = MessageEvent(
+            text=f"{PREAMBULE}\n\n{texte}",
+            message_type=MessageType.TEXT,
+            source=source,
+            internal=True,
+        )
+
+        boucle = getattr(_gateway, "_gateway_loop", None) or asyncio.get_event_loop()
+
+        # La profondeur est portee par un contexte copie, pas par le contexte
+        # courant : sans ca, le tour appelant resterait marque a +1 et son
+        # second reveil serait compte comme un troisieme.
+        contexte = contextvars.copy_context()
+        contexte.run(_PROFONDEUR.set, profondeur + 1)
+
+        def _lancer():
+            contexte.run(asyncio.ensure_future, adapter.handle_message(evenement))
+
+        if boucle.is_running():
+            boucle.call_soon_threadsafe(_lancer)
+        else:  # pragma: no cover - le gateway tourne toujours sa boucle
+            boucle.run_until_complete(adapter.handle_message(evenement))
+
+        return {"reveille": True, "profondeur": profondeur + 1}
+    except Exception as exc:
+        logger.warning("bus: reveil du topic %s echoue: %s", cle, exc)
+        return {"reveille": False, "raison": f"reveil echoue: {exc}"}
