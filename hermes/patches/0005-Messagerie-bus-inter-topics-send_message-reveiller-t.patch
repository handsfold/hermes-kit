         self._start_log_systemd_timing_alignment()
         # Log the resolved max_iterations so operators can verify the config.yaml → env bridge.
diff --git a/tests/gateway/test_bus.py b/tests/gateway/test_bus.py
new file mode 100644
index 0000000000..38333f242a
--- /dev/null
+++ b/tests/gateway/test_bus.py
@@ -0,0 +1,166 @@
+"""Bus inter-topics : le reveil d'une session, et surtout ses refus.
+
+Un bus sans garde est une boucle infinie qui attend son heure. Ces tests
+verifient d'abord que les gardes mordent, ensuite seulement que le cas
+nominal passe.
+"""
+import asyncio
+import contextvars
+
+import pytest
+
+from gateway import bus
+from gateway.session import Platform, SessionSource, build_session_key
+from gateway.session_context import set_session_vars
+
+CHAT = "-1001"
+THREAD = "2"
+
+
+class _Adapter:
+    def __init__(self):
+        self.recus = []
+        self.profondeurs = []
+
+    async def handle_message(self, event):
+        self.recus.append(event)
+        self.profondeurs.append(bus.profondeur_courante())
+
+
+class _Entree:
+    def __init__(self, origin):
+        self.origin = origin
+
+
+class _Store:
+    def __init__(self, entrees):
+        self._entrees = entrees
+
+    def list_sessions(self):
+        return self._entrees
+
+
+class _Gateway:
+    def __init__(self, adapter, source):
+        self.adapters = {Platform.TELEGRAM: adapter}
+        self.session_store = _Store([_Entree(source)])
+        self._gateway_loop = None
+
+    def _build_process_event_source(self, _d):
+        return None
+
+
+@pytest.fixture
+def bancs():
+    source = SessionSource(
+        platform=Platform.TELEGRAM, chat_id=CHAT, chat_type="group", thread_id=THREAD
+    )
+    adapter = _Adapter()
+    gw = _Gateway(adapter, source)
+    bus._derniers.clear()
+    bus._horodatages.clear()
+    bus.register_gateway(gw)
+    yield gw, adapter
+    bus.register_gateway(None)
+    bus._derniers.clear()
+    bus._horodatages.clear()
+
+
+def _dans_boucle(fn):
+    async def _run():
+        bus._gateway._gateway_loop = asyncio.get_running_loop()
+        out = fn()
+        await asyncio.sleep(0.05)
+        return out
+
+    return asyncio.run(_run())
+
+
+def test_reveil_nominal_injecte_un_tour_dans_la_bonne_session(bancs):
+    _, adapter = bancs
+    out = _dans_boucle(lambda: bus.reveiller("telegram", CHAT, THREAD, "Ou en est projet-a ?"))
+
+    assert out["reveille"] is True
+    assert len(adapter.recus) == 1
+    event = adapter.recus[0]
+    # internal=True : l'event synthetique saute l'autorisation utilisateur,
+    # sinon le gateway le rejette comme venant d'un inconnu.
+    assert event.internal is True
+    assert "Ou en est projet-a ?" in event.text
+    # Le destinataire doit savoir que ce n'est pas USER qui parle.
+    assert bus.PREAMBULE in event.text
+    assert build_session_key(event.source) == f"agent:main:telegram:group:{CHAT}:{THREAD}"
+
+
+def test_le_tour_reveille_voit_la_profondeur_incrementee(bancs):
+    _, adapter = bancs
+    _dans_boucle(lambda: bus.reveiller("telegram", CHAT, THREAD, "x"))
+    assert adapter.profondeurs == [1]
+
+
+def test_la_profondeur_de_l_appelant_reste_intacte(bancs):
+    _dans_boucle(lambda: bus.reveiller("telegram", CHAT, THREAD, "x"))
+    # Sans contexte copie, le tour appelant resterait marque a 1 et son
+    # deuxieme reveil serait compte comme un troisieme.
+    assert bus.profondeur_courante() == 0
+
+
+def test_profondeur_maximale_coupe_la_chaine(bancs):
+    def essai():
+        ctx = contextvars.copy_context()
+        ctx.run(bus._PROFONDEUR.set, bus.PROFONDEUR_MAX)
+        return ctx.run(bus.reveiller, "telegram", CHAT, THREAD, "trop loin")
+
+    out = _dans_boucle(essai)
+    assert out["reveille"] is False
+    assert "profondeur" in out["raison"]
+
+
+def test_auto_reveil_refuse(bancs):
+    def essai():
+        ctx = contextvars.copy_context()
+
+        def _dedans():
+            set_session_vars(session_key=f"agent:main:telegram:group:{CHAT}:{THREAD}")
+            return bus.reveiller("telegram", CHAT, THREAD, "moi-meme")
+
+        return ctx.run(_dedans)
+
+    out = _dans_boucle(essai)
+    assert out["reveille"] is False
+    assert "auto-reveil" in out["raison"]
+
+
+def test_cooldown_bloque_le_reveil_immediat_du_meme_topic(bancs):
+    def essai():
+        bus.reveiller("telegram", CHAT, THREAD, "un")
+        return bus.reveiller("telegram", CHAT, THREAD, "deux")
+
+    out = _dans_boucle(essai)
+    assert out["reveille"] is False
+
+
+def test_plafond_global_borne_un_emballement(bancs):
+    def essai():
+        acceptes = 0
+        for i in range(bus.REVEILS_MAX_PAR_FENETRE + 4):
+            bus._derniers.clear()  # neutralise le cooldown par topic
+            if bus.reveiller("telegram", CHAT, THREAD, f"m{i}")["reveille"]:
+                acceptes += 1
+        return acceptes
+
+    assert _dans_boucle(essai) == bus.REVEILS_MAX_PAR_FENETRE
+
+
+def test_sans_gateway_le_bus_est_inerte():
+    bus.register_gateway(None)
+    bus._derniers.clear()
+    out = bus.reveiller("telegram", CHAT, THREAD, "x")
+    assert out["reveille"] is False
+    assert "gateway" in out["raison"]
+
+
+def test_plateforme_sans_adaptateur(bancs):
+    out = _dans_boucle(lambda: bus.reveiller("discord", "123", None, "x"))
+    assert out["reveille"] is False
+    assert "adaptateur" in out["raison"]
diff --git a/tests/tools/test_send_message_reveiller.py b/tests/tools/test_send_message_reveiller.py
new file mode 100644
index 0000000000..95b435b6d8
--- /dev/null
+++ b/tests/tools/test_send_message_reveiller.py
@@ -0,0 +1,86 @@
+"""send_message(reveiller=true) : le bus prend la place du miroir.
+
+Le miroir ecrit en role assistant, donc l'agent d'en face relit le message
+comme sa propre parole passee et ne travaille jamais. Quand le reveil reussit,
+le miroir ne doit donc pas s'ajouter par-dessus : le tour reveille enregistre
+deja le message en role user.
+"""
+import json
+from unittest.mock import AsyncMock, patch
+
+from tests.tools.test_send_message_tool import _make_config, _run_async_immediately
+from tools.send_message_tool import send_message_tool
+
+
+def _envoyer(args):
+    config, _ = _make_config()
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("tools.interrupt.is_interrupted", return_value=False), \
+         patch("model_tools._run_async", side_effect=_run_async_immediately), \
+         patch("tools.send_message_tool._send_to_platform",
+               new=AsyncMock(return_value={"success": True})), \
+         patch("gateway.mirror.mirror_to_session", return_value=True) as miroir, \
+         patch("gateway.bus.reveiller") as reveil:
+        yield_result = json.loads(send_message_tool(args))
+    return yield_result, miroir, reveil
+
+
+def test_sans_reveiller_le_miroir_reste_le_comportement_par_defaut():
+    resultat, miroir, reveil = _envoyer(
+        {"action": "send", "target": "telegram:-1001:2", "message": "coucou"}
+    )
+    assert resultat["mirrored"] is True
+    reveil.assert_not_called()
+    miroir.assert_called_once()
+
+
+def test_reveil_reussi_remplace_le_miroir():
+    def _ok(*_a, **_k):
+        return {"reveille": True, "profondeur": 1}
+
+    config, _ = _make_config()
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("tools.interrupt.is_interrupted", return_value=False), \
+         patch("model_tools._run_async", side_effect=_run_async_immediately), \
+         patch("tools.send_message_tool._send_to_platform",
+               new=AsyncMock(return_value={"success": True})), \
+         patch("gateway.mirror.mirror_to_session", return_value=True) as miroir, \
+         patch("gateway.bus.reveiller", side_effect=_ok) as reveil:
+        resultat = json.loads(send_message_tool(
+            {"action": "send", "target": "telegram:-1001:2",
+             "message": "Ou en est projet-a ?", "reveiller": True}
+        ))
+
+    assert resultat["reveille"] is True
+    assert "mirrored" not in resultat
+    miroir.assert_not_called()
+    reveil.assert_called_once_with("telegram", "-1001", "2", "Ou en est projet-a ?")
+
+
+def test_reveil_refuse_retombe_sur_le_miroir_et_dit_pourquoi():
+    def _ko(*_a, **_k):
+        return {"reveille": False, "raison": "gateway indisponible dans ce processus"}
+
+    config, _ = _make_config()
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("tools.interrupt.is_interrupted", return_value=False), \
+         patch("model_tools._run_async", side_effect=_run_async_immediately), \
+         patch("tools.send_message_tool._send_to_platform",
+               new=AsyncMock(return_value={"success": True})), \
+         patch("gateway.mirror.mirror_to_session", return_value=True) as miroir, \
+         patch("gateway.bus.reveiller", side_effect=_ko):
+        resultat = json.loads(send_message_tool(
+            {"action": "send", "target": "telegram:-1001:2",
+             "message": "x", "reveiller": True}
+        ))
+
+    # L'envoi a reussi : un reveil refuse ne doit pas le transformer en echec.
+    assert resultat["success"] is True
+    assert resultat["reveille"] is False
+    assert "gateway indisponible" in resultat["reveil_refuse"]
+    miroir.assert_called_once()
+
+
+def test_le_parametre_est_declare_dans_le_schema():
+    from tools.send_message_tool import SEND_MESSAGE_SCHEMA
+    assert "reveiller" in SEND_MESSAGE_SCHEMA["parameters"]["properties"]
