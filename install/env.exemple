# Optional variables for the hermes-kit installer.
# Usage: fill this file and source it before running install/install.sh,
# or put the values in front of the command: HK_PRENOM=Alice bash install/install.sh
# Never commit a filled copy: the Telegram token is a secret.

# Answers (they skip the questions)
HK_PRENOM=                    # your first name
HK_TELEGRAM_TOKEN=            # token from @BotFather; reused from ~/.hermes/.env if it exists
HK_TELEGRAM_USER=             # your numeric Telegram id (if set, the installer does not wait for Start)
HK_LANG=en                    # en (default) or fr: test message and menus language
HK_PATCHES=0                  # 1 = also apply the optional Hermes patch series (default: official Hermes only)
HK_PIXEL_IP=                  # ADB IP of an Android phone for Creeper (optional; otherwise PixelGarde is not placed)

# The QG group, its topics and the group id are not variables any more.
# You press Start in your bot; Hermes creates the topics QG, Coach and Ideas in the private chat.

# Club (filled by the prompt of https://club.farangvin.com/kit/install)
HK_ARCHIVE_URL=               # personal link of the kit archive
HK_MEMBER_TOKEN=              # member token (derived from HK_ARCHIVE_URL if empty)
HK_EVENT_URL=                 # default: https://club.farangvin.com/api/kit/event
HK_TELEMETRIE=1               # 1 = anonymous statistics on (default; turn off with: hk telemetrie off|voir)

# No-terminal mode (Claude Code): 1 = never ask a question
HK_SANS_TERMINAL=0
HK_TELEGRAM_ATTENTE=180       # seconds to wait for your Start in the bot
HK_TOPICS_ATTENTE=60          # seconds to wait for Hermes to create the topics
HK_CI=0                       # 1 = installation test in CI: skips only the getMe check (fake token). Never on a real install

# Mailbox report (read-only, local database): only with the member's consent
HK_AUTOJB=non                 # oui = place the auto-jailbreak skill AND download its engine (PyRIT)
HK_BOITE=non                  # oui = read the mailbox and send the report to the QG topic
HK_BOITE_U=0                  # index of the Gmail account in Chrome (/mail/u/N)
HK_NAVIGATEUR_ATTENTE=420     # seconds to wait for the OpenCLI Chrome extension
HK_JOURNAL=/tmp/hermes-kit-install.log

# Locations
HK_HOME=~/.hermes-kit         # kit clone
HK_CONTEXTE=~/.hermes-kit/contexte   # focus, tasks, journal, lessons
HK_PROJETS=~/Projets          # root of your projects
HERMES_HOME=~/.hermes

# Steps to skip (1 = skip)
HK_SANS_CLAUDE_LOGIN=0
HK_SANS_PLUGINS=0
HK_SANS_RTK=0
HK_SANS_SERVICES=0
HK_SANS_NAVIGATEUR=0
HK_EMBED_PYTHON=              # skill router: a python with sentence-transformers (empty = keywords only)
HK_EMBED_MODEL=               # skill router: embedding model (default: paraphrase-multilingual-MiniLM-L12-v2)
HK_EMBED_CACHE=               # skill router: folder holding the downloaded model
HK_DECLENCHEURS=              # skill router: keyword table (default: ~/.claude/outils/declencheurs.json)
# Skill router, model path (hk-aiguilleur.py eval-llm / juger): Anthropic-format endpoint and model.
# HK_LLM_URL=http://localhost:8000/anthropic/v1/messages
# HK_LLM_MODEL=claude-sonnet-5-5
# HK_LLM_KEY=x
