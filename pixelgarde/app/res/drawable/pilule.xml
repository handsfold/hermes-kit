<?xml version="1.0" encoding="utf-8"?>
<!-- La pastille du bouton Lire : le vert du creeper, bien arrondi.
     Un bouton de notification doit se lire comme un bouton avant d'etre lu
     comme un mot, sinon USER ne le distingue pas du texte de la carte. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <solid android:color="#3DC27A" />
    <corners android:radius="24dp" />
</shape>
