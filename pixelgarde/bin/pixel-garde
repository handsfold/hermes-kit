PID = os.path.join(PIXEL_TMP, "pixel-garde.pid")
CMD_VU = os.path.join(PIXEL_TMP, "pixel-cmd-vu")   # horodatage de la derniere commande deja jouee
# Le relais reseau (bin/pixel/creeper-relais.py) : l'appli y poste ses appuis
# quand ADB ne passe plus (Tailscale ou debogage sans fil coupes, 4G).
RELAIS_RACINE = os.path.expanduser("~/.hermes/creeper-relais")
