# la a 11h). Passe ce delai sans le moindre changement d'etat, la conversation
# est morte : on retire les marqueurs et on rend la parole aux rapports.
VOIX_PEREMPTION_S = 600
# La pastille y depose chaque appui. Voir Bulle.deposer() : logcat est un flux
