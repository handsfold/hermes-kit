QG_VOIX = os.path.expanduser("~/.hermes/qg-voix")


def _qg_reglage(cle, defaut):
    """Un reglage du QG, ou son defaut si la configuration est illisible.

    Le garde ne doit JAMAIS mourir sur un fichier de configuration casse : il
    tient la pastille et l'arret d'urgence. En cas de doute il prend le defaut
    et continue. Les valeurs de reference sont dans hermes/scripts/qg-config.py.
    """
    try:
        with open(os.path.expanduser("~/.hermes/qg-config.json")) as f:
            return json.load(f).get(cle, defaut)
    except Exception:
        return defaut
PREVOIX = os.path.join(os.path.dirname(os.path.abspath(__file__)), "qg-prevoix.sh")
# Qui a la parole sur le telephone : LIBRE, LECTURE, FENETRE ou TOUR. Le meme
# fichier sert aux scripts d'actions par la ligne de commande. Revue du
# 2026-10-06 : sans cet etat commun, cinq producteurs de voix se coupaient.
_spec_lec = __import__("importlib.util").util.spec_from_file_location(
    "qg_lecture", os.path.join(os.path.dirname(os.path.abspath(__file__)), "qg-lecture"),
    loader=__import__("importlib.machinery").machinery.SourceFileLoader(
        "qg_lecture", os.path.join(os.path.dirname(os.path.abspath(__file__)), "qg-lecture")))
qg_lecture = __import__("importlib.util").util.module_from_spec(_spec_lec)
_spec_lec.loader.exec_module(qg_lecture)
# continu | silencieux. Le mode de lecture des rapports du QG, choisi par USER
# depuis la pastille. « silencieux » par defaut, et c'est deliberé : une voix
# qui part sans qu'on l'ait demandee dans une reunion coute plus cher qu'un
# rapport lu dix minutes trop tard. En « continu », le garde declenche la
# lecture groupee des qu'un rapport tombe, sans attendre d'appui.
QG_MODE = os.path.expanduser("~/.hermes/qg-voix-mode")
TACTILE = "/dev/input/event1"   # synaptics_tcm_touch
