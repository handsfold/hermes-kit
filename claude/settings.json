  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$TOOL_INPUT\" | grep -qiE '\"command\"\\s*:\\s*\"(git (push|commit|add)|pnpm (run )?build|npm run build|npx next build)' && $HOME/.claude/hooks/build-lock.sh acquire || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || python3 $HOME/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "statusMessage": "PreToolUse",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v rtk >/dev/null 2>&1 && rtk hook claude || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/outil-existant.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/garde-gateway.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/agent-fond-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/portail-sonnet.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/carnet-site.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/commit-sans-attribution.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/envoi-sans-accord.py"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/attente-sans-fin.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/ouvert-ferme.py note"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/projet-sans-famille.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/projet-sans-socle.py"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || python3 $HOME/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "statusMessage": "PermissionRequest",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$TOOL_INPUT\" | grep -qiE '\"command\"\\s*:\\s*\"(git (push|commit|add)|pnpm (run )?build|npm run build|npx next build)' && $HOME/.claude/hooks/build-lock.sh release || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || python3 $HOME/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "statusMessage": "PostToolUse",
            "async": true
          }
        ]
      },
      {
        "matcher": "Skill|Read|skill_view",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/journal-skills.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/controle-video.py",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || python3 $HOME/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "statusMessage": "PostToolUseFailure",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/journal-skills.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || python3 $HOME/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "statusMessage": "UserPromptSubmit",
            "async": true
          },
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || bash $HOME/.claude/hooks/cc-session-label.sh",
            "timeout": 5000,
            "statusMessage": "Nommage de la session",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/journal-skills.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 $HOME/.claude/hooks/skills-forcees.py",
            "timeout": 5,
            "statusMessage": "Skills a charger"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 $HOME/.claude/hooks/aiguilleur-cc.py",
            "timeout": 20,
            "statusMessage": "Choix de la skill"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || notify-send -i utilities-terminal 'Claude Code' 'En attente de ton input'"
          },
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_TIMEOUT_MS\" ] || python3 $HOME/.claude/hooks/scripts/hooks.py",
            "timeout": 5000,
            "statusMessage": "Notification",
            "async": true
